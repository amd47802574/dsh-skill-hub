{
  "name": "dsh-skill-hub",
  "version": "1.3.1",
  "description": "Manage and discover agent skills: a sidebar hub that browses, searches, imports (folder or GitHub), and inspects every skill registered in DeepSeek Harness",
  "license": "MIT",
  "author": "amd47802574",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amd47802574/dsh-skill-hub.git"
  },
  "homepage": "https://github.com/amd47802574/dsh-skill-hub#readme",
  "bugs": {
    "url": "https://github.com/amd47802574/dsh-skill-hub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "skill-manager",
    "skill-browser",
    "github-import"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
